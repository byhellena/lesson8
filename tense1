function science(t){$('science').textContent=t}function nextPhase(){if(phase===0&&cables.length===3){phase=1;selected=null;setInstruction('② 막대를 먼저 윗삼각형의 표시된 모서리에, 다음은 아랫삼각형의 표시된 모서리에 붙이세요!');science('중력은 위 삼각형을 아래로 끌어당깁니다. 고무줄은 당길 수만 있고 위로 밀어 올릴 수 없습니다. 위쪽 구조물에 작용하는 힘의 합력(알짜힘)이 0이 되도록 지지하는 압축 부재와 장력 부재가 더 필요합니다.');status('왼쪽에서 나무 막대 → 놓기를 누르고, 막대를 반짝이는 화살표로 끌어다 놓으세요.');}
