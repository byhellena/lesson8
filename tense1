function buildExample(i,showAnswer=false){collapseActive=false;activity=1;example=i;finished=false;hand=false;selected=null;phase=0;placed=0;preview=null;tool='rubber';$('hand').classList.remove('active');const n=[3,4,6][i],r=n===6?.83:1.02,h=1.55;points=[];for(let level=0;level<2;level++)for(let j=0;j<n;j++){let a=-PI/2+2*PI*j/n+(level?.22:0);points.push(V(r*Math.cos(a),level?h:.08,r*Math.sin(a)))}rods=[];for(let j=0;j<n;j++)rods.push(edge(j,n+(j+1)%n));edges=[];for(let j=0;j<n;j++){edges.push(edge(j,(j+1)%n));edges.push(edge(n+j,n+(j+1)%n));edges.push(edge(j,n+j))}missing=examples[i].missing.filter(k=>k<edges.length);cables=edges.filter((_,k)=>showAnswer||!missing.includes(k)).map(e=>({...e}));if(showAnswer)finished=true;refreshExamples();updateNext();setInstruction(showAnswer?'정답 구조입니다. 연결된 장력 부재를 관찰하세요.':'어디에 장력 부재가 필요한지 스스로 탐구하세요.');rollYaw=0;rollPitch=0;status(showAnswer?'🔓 정답을 표시했습니다. 정답 보기는 성공 기록에 포함되지 않습니다.':'고무줄을 고른 뒤 끝점 두 개를 클릭하여 연결하세요.');}
