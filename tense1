function resize(){const rect=cv.getBoundingClientRect(),d=Math.min(devicePixelRatio||1,2);W=rect.width;H=rect.height;cv.width=Math.round(W*d);cv.height=Math.round(H*d);ctx.setTransform(d,0,0,d,0,0)}window.addEventListener('resize',resize);
function project(p){let x=p.x,z=p.z,y=p.y-.82;const co=Math.cos(yaw),si=Math.sin(yaw),a=x*co-z*si,b=x*si+z*co;const c=Math.cos(pitch),s=Math.sin(pitch),v=y*c-b*s,depth=y*s+b*c;const scale=Math.min(W*.61,H*.70)*zoom/(3.4-depth*.18);return {x:W*.49+a*scale,y:H*.57-v*scale,scale}}function drawLine(a,b,color,width=4){const p=project(a),q=project(b);ctx.strokeStyle=color;ctx.lineWidth=width;ctx.lineCap='round';ctx.beginPath();ctx.moveTo(p.x,p.y);ctx.lineTo(q.x,q.y);ctx.stroke()}
