'use strict';const $=id=>document.getElementById(id),cv=$('canvas'),ctx=cv.getContext('2d');let passwordPurpose='answer';let answerViewed=false,compression=0,compressionVelocity=0,compressionTarget=0,collapseStart=0,collapseActive=false;let activity=1,example=0,success=[false,false,false],cables=[],missing=[],selected=null,tool='rubber',hand=false,finished=false,phase=0,placed=0,drag=null,zoom=1,yaw=.42,pitch=.32,impulse=0,impulseX=0,impulseY=0,feedback='',W=800,H=600,preview=null;const PI=Math.PI;
