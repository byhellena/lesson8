let points=[],rods=[],edges=[],targets=[],rollYaw=0,rollPitch=0;function edge(a,b){return {a,b}}function setInstruction(t){$('instruction').textContent=t}function status(t){$('status').textContent=t}function refreshExamples(){$('examples').innerHTML=examples.map((e,i)=>`<button class="choice ${i===example?'active':''} ${success[i]?'gold':''}" data-i="${i}">${['🔺','🔲','⬡'][i]} ${e.name}<small>${success[i]?'🏆 성공!':'직접 균형을 찾아보세요'}</small></button>`).join('')}
