function chooseTool(t){tool=t;selected=null;$('r2').classList.toggle('active',t==='rubber');$('stick').classList.toggle('active',t==='stick');$('place').disabled=!(activity===2&&phase===1&&t==='stick'&&placed<2);status(t==='rubber'?'고무줄을 선택했습니다. 연결할 점 두 곳을 클릭하세요.':'나무 막대를 선택했습니다. 놓기 버튼을 누르세요.')}
